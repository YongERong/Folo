# Expo / EAS (fork setup)
# Create a token at https://expo.dev/settings/access-tokens
EXPO_TOKEN=

# Filled automatically by: pnpm --dir apps/mobile run setup:eas-fork
EXPO_OWNER=
EXPO_SLUG=folo-dev
EAS_PROJECT_ID=

# Use unique IDs for personal forks (cannot reuse RSSNext's is.follow without their Apple/Google accounts)
IOS_BUNDLE_IDENTIFIER=is.follow.dev.yourname
ANDROID_PACKAGE=is.follow.dev.yourname

# Disable upstream OTA endpoint for forks (default when not on @follow project)
EXPO_UPDATES_ENABLED=false

# Local development
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Optional
SENTRY_AUTH_TOKEN=
